# Nusxa oling: copy .env.example .env  (Windows)  yoki  cp .env.example .env
DJANGO_SECRET_KEY=ozgartiring-uzun-tasodifiy-kalit
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL (yoki MariaDB)
DB_NAME=clinic_db
DB_USER=clinic_user
DB_PASSWORD=ozgartiring
DB_HOST=127.0.0.1
DB_PORT=3306

# Production (HTTPS) uchun True qiling
DJANGO_SECURE_COOKIES=False
CSRF_TRUSTED_ORIGINS=

# Vaqt zonasi
TIME_ZONE=Asia/Tashkent

# Yuz ma'lumotlarini shifrlash kaliti (Fernet). Yaratish:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FACE_ENCRYPTION_KEY=

# Yuz verifikatsiyasi: face_recognition kutubxonasi o'rnatilgan bo'lsa True
# O'rnatilmagan bo'lsa tizim davomatni yuz orqali TASDIQLAMAYDI.
FACE_VERIFICATION_ENABLED=False
# Masofa chegarasi (kichikroq = qattiqroq). Tavsiya: 0.5
FACE_MATCH_TOLERANCE=0.5

# Android ilova (Play Market). Imzo barmoq izini keystore yaratgandan keyin kiriting (README, "Android ilova")
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINTS=
CLINIC_NAME=Gold Med Clinic
PRIVACY_CONTACT=
